<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- See NetPlugHost.csproj: PlatformTarget pins x64 without breaking the solution's
         "Any CPU" configuration mapping. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <RootNamespace>NetPlugHost.HeadlessTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\managed\NetPlugHost\NetPlugHost.csproj" />
  </ItemGroup>

  <!-- The native DLL must sit beside this test's own binary, not just beside
       NetPlugHost.dll — a ProjectReference doesn't carry loose native files across. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\NetPlugHost.Native.targets" />

</Project>
